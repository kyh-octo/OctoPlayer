<Window x:Class="OctoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OctoPlayer" Width="1180" Height="680" MinWidth="640" MinHeight="400"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" AllowDrop="True" Icon="/Properties/OctoPlayer.ico"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter" Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 재생목록: 제목 목록 보기 -->
        <DataTemplate x:Key="PlaylistTitleTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        Visibility="{Binding PlayingVisibility}"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="7,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{Binding TitleBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- 재생목록: 미리보기(썸네일) 보기 -->
        <DataTemplate x:Key="PlaylistThumbTemplate">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        Visibility="{Binding PlayingVisibility}"/>
                <Border Grid.Column="1" Width="96" Height="54" Margin="6,0,0,0" CornerRadius="4"
                        Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="8,0,4,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding TitleBrush}" FontSize="12"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 타이틀바 ================= -->
        <DockPanel x:Name="TitleBar" Grid.Row="0" Height="36" Background="{StaticResource BarBrush}"
                   MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Image Source="/Properties/OctoPlayer.ico" Width="16" Height="16" Margin="12,0,8,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="─" Click="Caption_Minimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="□" Click="Caption_Maximize"/>
                <Button Style="{StaticResource CaptionButton}" Content="✕" Click="Caption_Close"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="OctoPlayer" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ================= 콘텐츠 영역 =================
             창 모드: 영상(좌) / 재생목록(우 열) / 컨트롤바(하단 행) — 서로 가리지 않음.
             전체화면: 재생목록/컨트롤바를 코드에서 OverlayRoot(영상 위 오버레이)로 옮겨 표시. -->
        <Grid x:Name="ContentArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <vlc:VideoView x:Name="VideoView" Grid.Row="0" Grid.Column="0" Background="Black">
            <!-- 배경 알파를 1로 두는 이유: 오버레이는 투명 레이어드 창이라 완전 투명(alpha=0) 영역은
                 OS가 클릭을 아래(영상 창)로 통과시켜 더블클릭/우클릭/휠이 전혀 동작하지 않습니다. -->
            <Grid x:Name="OverlayRoot" Background="#01000000"
                  MouseWheel="OverlayRoot_MouseWheel"
                  PreviewMouseDown="OverlayRoot_PreviewMouseDown"
                  MouseMove="OverlayRoot_MouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 우클릭 컨텍스트 메뉴 (UI 정의부) ===== -->
                <Grid.ContextMenu>
                    <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
                        <MenuItem Header="열기">
                            <MenuItem Header="파일 열기..." InputGestureText="F3" Click="Menu_OpenFile"/>
                            <MenuItem Header="주소 열기..." InputGestureText="Ctrl+U" Click="Menu_OpenUrl"/>
                            <MenuItem Header="폴더 열기..." InputGestureText="F2" Click="Menu_OpenFolder"/>
                        </MenuItem>
                        <MenuItem Header="닫기" InputGestureText="F4" Click="Menu_CloseMedia"/>
                        <Separator/>
                        <MenuItem Header="재생">
                            <MenuItem Header="재생/일시 중지" InputGestureText="Space" Click="Menu_PlayPause"/>
                            <MenuItem Header="이전 파일 재생" InputGestureText="PgUp" Click="Menu_PrevFile"/>
                            <MenuItem Header="다음 파일 재생" InputGestureText="PgDn" Click="Menu_NextFile"/>
                            <Separator/>
                            <MenuItem Header="재생 속도">
                                <MenuItem Header="느리게 (0.1배)" InputGestureText="X" Click="Menu_SpeedDown"/>
                                <MenuItem Header="빠르게 (0.1배)" InputGestureText="C" Click="Menu_SpeedUp"/>
                                <MenuItem Header="보통 속도 (1.0배)" InputGestureText="Z" Click="Menu_SpeedReset"/>
                            </MenuItem>
                            <MenuItem Header="구간 반복">
                                <MenuItem x:Name="MiAbA" Header="시작 지점 지정 (A)" InputGestureText="[" Click="Menu_AbSetA"/>
                                <MenuItem x:Name="MiAbB" Header="끝 지점 지정 (B)" InputGestureText="]" Click="Menu_AbSetB"/>
                                <MenuItem Header="구간 반복 해제" Click="Menu_AbClear"/>
                            </MenuItem>
                            <MenuItem x:Name="MiRepeatMode" Header="반복 재생 토글" Click="Menu_CycleRepeat"/>
                            <MenuItem x:Name="MiShuffle" Header="셔플 재생" Click="Menu_ToggleShuffle"/>
                        </MenuItem>
                        <MenuItem Header="자막">
                            <MenuItem x:Name="MiSubVisible" Header="자막 보이기" InputGestureText="Alt+H" Click="Menu_ToggleSubtitles"/>
                            <MenuItem Header="자막 열기..." InputGestureText="Alt+O" Click="Menu_OpenSubtitle"/>
                            <Separator/>
                            <MenuItem Header="자막 싱크">
                                <MenuItem Header="0.5초 느리게" InputGestureText="," Click="Menu_SubDelayMinus"/>
                                <MenuItem Header="0.5초 빠르게" InputGestureText="." Click="Menu_SubDelayPlus"/>
                                <MenuItem Header="싱크 초기화" Click="Menu_SubDelayReset"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MiSubTracks" Header="자막 트랙">
                                <MenuItem Header="(없음)" IsEnabled="False"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="영상">
                            <MenuItem Header="영상 캡처" InputGestureText="Ctrl+S" Click="Menu_Capture"/>
                            <MenuItem Header="화면 회전" InputGestureText="R" Click="Menu_Rotate"/>
                            <Separator/>
                            <MenuItem Header="영상 속성">
                                <MenuItem Header="명도 높이기" Click="Menu_BrightUp"/>
                                <MenuItem Header="명도 낮추기" Click="Menu_BrightDown"/>
                                <MenuItem Header="대비 높이기" Click="Menu_ContrastUp"/>
                                <MenuItem Header="대비 낮추기" Click="Menu_ContrastDown"/>
                                <MenuItem Header="채도 높이기" Click="Menu_SaturationUp"/>
                                <MenuItem Header="채도 낮추기" Click="Menu_SaturationDown"/>
                                <MenuItem Header="색상 +" Click="Menu_HueUp"/>
                                <MenuItem Header="색상 -" Click="Menu_HueDown"/>
                                <Separator/>
                                <MenuItem Header="속성 초기화" InputGestureText="Q" Click="Menu_AdjustReset"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="소리">
                            <MenuItem Header="소리 크게" InputGestureText="Up" Click="Menu_VolumeUp"/>
                            <MenuItem Header="소리 작게" InputGestureText="Down" Click="Menu_VolumeDown"/>
                            <MenuItem x:Name="MiMute" Header="음소거" InputGestureText="M" Click="Menu_ToggleMute"/>
                            <Separator/>
                            <MenuItem x:Name="MiAudioTracks" Header="오디오 트랙">
                                <MenuItem Header="(없음)" IsEnabled="False"/>
                            </MenuItem>
                            <MenuItem x:Name="MiEqualizer" Header="이퀄라이저">
                                <MenuItem Header="(로딩)" IsEnabled="False"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="팬 &amp; 스캔">
                            <MenuItem Header="왼쪽으로 이동" InputGestureText="Num 4" Click="Menu_PanLeft"/>
                            <MenuItem Header="오른쪽으로 이동" InputGestureText="Num 6" Click="Menu_PanRight"/>
                            <MenuItem Header="위로 이동" InputGestureText="Num 8" Click="Menu_PanUp"/>
                            <MenuItem Header="아래로 이동" InputGestureText="Num 2" Click="Menu_PanDown"/>
                            <Separator/>
                            <MenuItem Header="확대" InputGestureText="Num +" Click="Menu_ZoomIn"/>
                            <MenuItem Header="축소" InputGestureText="Num -" Click="Menu_ZoomOut"/>
                            <MenuItem Header="위치/크기 초기화" InputGestureText="Num 5" Click="Menu_PanScanReset"/>
                        </MenuItem>
                        <MenuItem Header="화면 비율">
                            <MenuItem x:Name="MiAspectKeep" Header="화면 비율 유지 (권장)" Click="Menu_AspectKeep"/>
                            <MenuItem x:Name="MiAspectOrig" Header="원본 비율" Click="Menu_AspectOriginal"/>
                            <MenuItem x:Name="MiAspect43" Header="4:3" Click="Menu_Aspect43"/>
                            <MenuItem x:Name="MiAspect169" Header="16:9" Click="Menu_Aspect169"/>
                            <MenuItem x:Name="MiAspect1610" Header="16:10" Click="Menu_Aspect1610"/>
                            <MenuItem x:Name="MiAspect235" Header="2.35:1" Click="Menu_Aspect235"/>
                        </MenuItem>
                        <MenuItem Header="화면 크기">
                            <MenuItem Header="0.5배 크기" InputGestureText="1" Click="Menu_Size05"/>
                            <MenuItem Header="1.0배 크기" InputGestureText="2" Click="Menu_Size10"/>
                            <MenuItem Header="1.5배 크기" InputGestureText="3" Click="Menu_Size15"/>
                            <MenuItem Header="2.0배 크기" InputGestureText="4" Click="Menu_Size20"/>
                            <Separator/>
                            <MenuItem x:Name="MiFullscreen" Header="전체 화면" InputGestureText="Alt+Enter" Click="Menu_Fullscreen"/>
                            <MenuItem Header="꽉찬 화면" InputGestureText="Ctrl+Enter" Click="Menu_Maximize"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="환경 설정..." InputGestureText="F5" Click="Menu_Settings"/>
                        <MenuItem x:Name="MiPlaylist" Header="재생목록" InputGestureText="F6" Click="Menu_TogglePlaylist"/>
                        <MenuItem Header="제어창..." InputGestureText="F7" Click="Menu_Controller"/>
                        <Separator/>
                        <MenuItem Header="재생 정보..." InputGestureText="Ctrl+F1" Click="Menu_MediaInfo"/>
                        <MenuItem Header="프로그램 정보..." InputGestureText="F1" Click="Menu_About"/>
                        <Separator/>
                        <MenuItem Header="종료" InputGestureText="Alt+F4" Click="Caption_Close"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- 영상 표면(3분할 더블클릭 감지) -->
                <Border x:Name="VideoSurface" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"/>

                <!-- 대기 화면: 재생 중이 아닐 때 검은 배경 + 회사 로고
                     (IsHitTestVisible=False로 클릭은 아래 VideoSurface가 그대로 받습니다) -->
                <Border x:Name="IdleLogo" Grid.Row="0" Background="Black" IsHitTestVisible="False">
                    <Image Source="/Assets/Logo.png" Width="190"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- OSD 토스트 -->
                <Border x:Name="Toast" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,24,0,0" Background="{StaticResource OverlayBarBrush}" CornerRadius="8"
                        Padding="16,8" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                </Border>

                <!-- ===== 재생목록 패널 ===== -->
                <Grid x:Name="PlaylistPanel" Grid.Row="0" HorizontalAlignment="Right" Width="280"
                      Background="{StaticResource OverlayBarBrush}" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,2"
                                Content="✕" Click="Menu_TogglePlaylist" ToolTip="재생목록 닫기 (F6)"/>
                        <Button x:Name="ViewModeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Padding="6,2" Content="▤" Click="ViewModeButton_Click" ToolTip="보기 방식 전환"/>
                        <TextBlock Text="재생목록" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="PlaylistList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="PlaylistList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="PlaylistList_PreviewMouseRightButtonDown"
                             RequestBringIntoView="PlaylistList_RequestBringIntoView">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="PlaylistMenu" Opened="PlaylistMenu_Opened">
                                <MenuItem x:Name="MiPlRemove" Header="재생목록에서 제거" Click="PlaylistMenu_Remove"/>
                                <MenuItem x:Name="MiPlDelete" Header="파일 삭제..." Click="PlaylistMenu_Delete"/>
                                <Separator/>
                                <MenuItem Header="보기 방식">
                                    <MenuItem x:Name="MiPlViewTitles" Header="제목 목록" Click="PlaylistMenu_ViewTitles"/>
                                    <MenuItem x:Name="MiPlViewThumbs" Header="미리보기" Click="PlaylistMenu_ViewThumbs"/>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 좌측 가장자리 폭 조절 손잡이 -->
                    <Thumb x:Name="PlaylistResizeThumb" Grid.RowSpan="2" Width="6" HorizontalAlignment="Left"
                           Cursor="SizeWE" DragDelta="PlaylistResizeThumb_DragDelta"
                           DragCompleted="PlaylistResizeThumb_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>

                <!-- ===== 전체화면 상단 오버레이 (창 제어) =====
                     마우스를 화면 상단에 대면 표시됩니다. 재생목록/컨트롤바와는 동시에 표시되지 않습니다. -->
                <Border x:Name="TopOverlay" Grid.Row="0" VerticalAlignment="Top" Height="44"
                        Background="{StaticResource OverlayBarBrush}" Visibility="Collapsed">
                    <DockPanel VerticalAlignment="Center" Margin="14,0,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButton}" Content="❐" ToolTip="창 모드 (Esc)"
                                    Click="Menu_Fullscreen"/>
                            <Button Style="{StaticResource CaptionButton}" Content="─" ToolTip="최소화"
                                    Click="Caption_Minimize"/>
                            <Button Style="{StaticResource CaptionButton}" Content="✕" ToolTip="닫기"
                                    Click="Caption_Close"/>
                        </StackPanel>
                        <TextBlock x:Name="TopOverlayTitle" Text="OctoPlayer" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ===== 하단 컨트롤바 ===== -->
                <Border x:Name="ControlBar" Grid.Row="1" Background="{StaticResource OverlayBarBrush}" Padding="12,6,12,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="CurrentTimeText" Text="00:00:00" DockPanel.Dock="Left"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <TextBlock x:Name="TotalTimeText" Text="00:00:00" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Maximum="1000"
                                    PreviewMouseDown="SeekSlider_PreviewMouseDown"
                                    PreviewMouseUp="SeekSlider_PreviewMouseUp"
                                    ValueChanged="SeekSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource IconButton}" Content="열기" Click="Menu_OpenFile"
                                        VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TransportButton}" Click="Menu_PrevFile" ToolTip="이전 파일 (PgUp)">
                                    <Path Data="{StaticResource IconPrev}" Fill="{StaticResource TextBrush}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                                        Click="Menu_PlayPause" ToolTip="재생/일시 중지 (Space)">
                                    <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}" Fill="White"
                                          Width="15" Height="15" Stretch="Uniform" Margin="3,0,0,0"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Click="Stop_Click" ToolTip="정지">
                                    <Path Data="{StaticResource IconStop}" Fill="{StaticResource TextBrush}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Click="Menu_NextFile" ToolTip="다음 파일 (PgDn)">
                                    <Path Data="{StaticResource IconNext}" Fill="{StaticResource TextBrush}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,6"/>
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="셔플" Click="Menu_ToggleShuffle"/>
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="반복: 없음" Click="Menu_CycleRepeat"/>
                                <Button x:Name="RepeatCountButton" Style="{StaticResource IconButton}" Content="×1"
                                        ToolTip="반복 횟수" Click="RepeatCount_Click"/>
                                <TextBlock x:Name="RateText" Text="1x" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock x:Name="VolumeText" Text="100" VerticalAlignment="Center" Margin="0,0,6,0"
                                           FontSize="12" Cursor="Hand" MouseLeftButtonDown="VolumeText_Click"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource MediaSlider}" Width="110"
                                        Maximum="100" Value="100" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        PreviewMouseUp="VolumeSlider_PreviewMouseUp"/>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,6"/>
                                <Button Style="{StaticResource IconButton}" Content="↻ 회전" Click="Menu_Rotate"/>
                                <Button Style="{StaticResource IconButton}" Content="전체화면" Click="Menu_Fullscreen"/>
                                <Button x:Name="PlaylistToggleButton" Style="{StaticResource IconButton}" Content="재생목록" Click="Menu_TogglePlaylist"/>
                            </StackPanel>
                            <Border/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
        </Grid>
    </Grid>
</Window>

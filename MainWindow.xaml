<Window x:Class="OctoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OctoPlayer" Width="1180" Height="680" MinWidth="640" MinHeight="400"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" AllowDrop="True" Icon="/Properties/OctoPlayer.ico"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter" Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 재생목록: 제목 목록 보기 -->
        <DataTemplate x:Key="PlaylistTitleTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        Visibility="{Binding PlayingVisibility}"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="7,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{Binding TitleBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- 재생목록: 미리보기(썸네일) 보기 -->
        <DataTemplate x:Key="PlaylistThumbTemplate">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        Visibility="{Binding PlayingVisibility}"/>
                <Border Grid.Column="1" Width="96" Height="54" Margin="6,0,0,0" CornerRadius="4"
                        Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="8,0,4,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding TitleBrush}" FontSize="12"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 타이틀바 ================= -->
        <DockPanel x:Name="TitleBar" Grid.Row="0" Height="36" Background="{StaticResource BarBrush}"
                   MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Image Source="/Properties/OctoPlayer.ico" Width="16" Height="16" Margin="12,0,8,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="─" Click="Caption_Minimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="□" Click="Caption_Maximize"/>
                <Button Style="{StaticResource CaptionButton}" Content="✕" Click="Caption_Close"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="OctoPlayer" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ================= 콘텐츠 영역 =================
             창 모드: 영상(좌) / 재생목록(우 열) / 컨트롤바(하단 행) — 서로 가리지 않음.
             전체화면: 재생목록/컨트롤바를 코드에서 OverlayRoot(영상 위 오버레이)로 옮겨 표시. -->
        <Grid x:Name="ContentArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <vlc:VideoView x:Name="VideoView" Grid.Row="0" Grid.Column="0" Background="Black">
            <!-- 배경 알파를 1로 두는 이유: 오버레이는 투명 레이어드 창이라 완전 투명(alpha=0) 영역은
                 OS가 클릭을 아래(영상 창)로 통과시켜 더블클릭/우클릭/휠이 전혀 동작하지 않습니다. -->
            <!-- TextElement.*를 명시하는 이유: 전체화면에서 재생목록/컨트롤바가 이 오버레이
                 (libVLC가 만드는 별도 투명 창)로 이동하면 메인 창의 글꼴/글자색 상속이 끊겨
                 기본값(검정 글자)이 적용돼 다크 배경에서 보이지 않았습니다. -->
            <Grid x:Name="OverlayRoot" Background="#01000000"
                  TextElement.Foreground="{StaticResource TextBrush}"
                  TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
                  MouseWheel="OverlayRoot_MouseWheel"
                  PreviewMouseDown="OverlayRoot_PreviewMouseDown"
                  MouseMove="OverlayRoot_MouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 우클릭 컨텍스트 메뉴 (UI 정의부) ===== -->
                <Grid.ContextMenu>
                    <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
                        <MenuItem Header="{DynamicResource S_MenuOpen}">
                            <MenuItem Header="{DynamicResource S_OpenFile}" InputGestureText="F3" Click="Menu_OpenFile"/>
                            <MenuItem Header="{DynamicResource S_OpenUrl}" InputGestureText="Ctrl+U" Click="Menu_OpenUrl"/>
                            <MenuItem Header="{DynamicResource S_OpenFolder}" InputGestureText="F2" Click="Menu_OpenFolder"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_Close}" InputGestureText="F4" Click="Menu_CloseMedia"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S_MenuPlay}">
                            <MenuItem Header="{DynamicResource S_PlayPause}" InputGestureText="Space" Click="Menu_PlayPause"/>
                            <MenuItem Header="{DynamicResource S_PrevFile}" InputGestureText="PgUp" Click="Menu_PrevFile"/>
                            <MenuItem Header="{DynamicResource S_NextFile}" InputGestureText="PgDn" Click="Menu_NextFile"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S_Speed}">
                                <MenuItem Header="{DynamicResource S_SpeedDown}" InputGestureText="X" Click="Menu_SpeedDown"/>
                                <MenuItem Header="{DynamicResource S_SpeedUp}" InputGestureText="C" Click="Menu_SpeedUp"/>
                                <MenuItem Header="{DynamicResource S_SpeedReset}" InputGestureText="Z" Click="Menu_SpeedReset"/>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource S_AbRepeat}">
                                <MenuItem x:Name="MiAbA" Header="{DynamicResource S_AbSetA}" InputGestureText="[" Click="Menu_AbSetA"/>
                                <MenuItem x:Name="MiAbB" Header="{DynamicResource S_AbSetB}" InputGestureText="]" Click="Menu_AbSetB"/>
                                <MenuItem Header="{DynamicResource S_AbClear}" Click="Menu_AbClear"/>
                            </MenuItem>
                            <MenuItem x:Name="MiRepeatMode" Header="{DynamicResource S_RepeatToggle}" Click="Menu_CycleRepeat"/>
                            <MenuItem x:Name="MiShuffle" Header="{DynamicResource S_Shuffle}" Click="Menu_ToggleShuffle"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_MenuSubtitles}">
                            <MenuItem x:Name="MiSubVisible" Header="{DynamicResource S_SubVisible}" InputGestureText="Alt+H" Click="Menu_ToggleSubtitles"/>
                            <MenuItem Header="{DynamicResource S_OpenSubtitle}" InputGestureText="Alt+O" Click="Menu_OpenSubtitle"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S_SubSync}">
                                <MenuItem Header="{DynamicResource S_SubSlower}" InputGestureText="," Click="Menu_SubDelayMinus"/>
                                <MenuItem Header="{DynamicResource S_SubFaster}" InputGestureText="." Click="Menu_SubDelayPlus"/>
                                <MenuItem Header="{DynamicResource S_SubSyncReset}" Click="Menu_SubDelayReset"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MiSubTracks" Header="{DynamicResource S_SubTracks}">
                                <MenuItem Header="{DynamicResource S_None}" IsEnabled="False"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_MenuVideo}">
                            <MenuItem Header="{DynamicResource S_Capture}" InputGestureText="Ctrl+S" Click="Menu_Capture"/>
                            <MenuItem Header="{DynamicResource S_Rotate}" InputGestureText="R" Click="Menu_Rotate"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S_VideoAdjust}">
                                <MenuItem Header="{DynamicResource S_BrightUp}" Click="Menu_BrightUp"/>
                                <MenuItem Header="{DynamicResource S_BrightDown}" Click="Menu_BrightDown"/>
                                <MenuItem Header="{DynamicResource S_ContrastUp}" Click="Menu_ContrastUp"/>
                                <MenuItem Header="{DynamicResource S_ContrastDown}" Click="Menu_ContrastDown"/>
                                <MenuItem Header="{DynamicResource S_SatUp}" Click="Menu_SaturationUp"/>
                                <MenuItem Header="{DynamicResource S_SatDown}" Click="Menu_SaturationDown"/>
                                <MenuItem Header="{DynamicResource S_HueUp}" Click="Menu_HueUp"/>
                                <MenuItem Header="{DynamicResource S_HueDown}" Click="Menu_HueDown"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource S_AdjustReset}" InputGestureText="Q" Click="Menu_AdjustReset"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_MenuAudio}">
                            <MenuItem Header="{DynamicResource S_VolumeUp}" InputGestureText="Up" Click="Menu_VolumeUp"/>
                            <MenuItem Header="{DynamicResource S_VolumeDown}" InputGestureText="Down" Click="Menu_VolumeDown"/>
                            <MenuItem x:Name="MiMute" Header="{DynamicResource S_Mute}" InputGestureText="M" Click="Menu_ToggleMute"/>
                            <Separator/>
                            <MenuItem x:Name="MiAudioTracks" Header="{DynamicResource S_AudioTracks}">
                                <MenuItem Header="{DynamicResource S_None}" IsEnabled="False"/>
                            </MenuItem>
                            <MenuItem x:Name="MiEqualizer" Header="{DynamicResource S_Equalizer}">
                                <MenuItem Header="{DynamicResource S_Loading}" IsEnabled="False"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_PanScan}">
                            <MenuItem Header="{DynamicResource S_PanLeft}" InputGestureText="Num 4" Click="Menu_PanLeft"/>
                            <MenuItem Header="{DynamicResource S_PanRight}" InputGestureText="Num 6" Click="Menu_PanRight"/>
                            <MenuItem Header="{DynamicResource S_PanUp}" InputGestureText="Num 8" Click="Menu_PanUp"/>
                            <MenuItem Header="{DynamicResource S_PanDown}" InputGestureText="Num 2" Click="Menu_PanDown"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S_ZoomIn}" InputGestureText="Num +" Click="Menu_ZoomIn"/>
                            <MenuItem Header="{DynamicResource S_ZoomOut}" InputGestureText="Num -" Click="Menu_ZoomOut"/>
                            <MenuItem Header="{DynamicResource S_PanScanReset}" InputGestureText="Num 5" Click="Menu_PanScanReset"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_MenuAspect}">
                            <MenuItem x:Name="MiAspectKeep" Header="{DynamicResource S_AspectKeep}" Click="Menu_AspectKeep"/>
                            <MenuItem x:Name="MiAspectOrig" Header="{DynamicResource S_AspectOrig}" Click="Menu_AspectOriginal"/>
                            <MenuItem x:Name="MiAspect43" Header="4:3" Click="Menu_Aspect43"/>
                            <MenuItem x:Name="MiAspect169" Header="16:9" Click="Menu_Aspect169"/>
                            <MenuItem x:Name="MiAspect1610" Header="16:10" Click="Menu_Aspect1610"/>
                            <MenuItem x:Name="MiAspect235" Header="2.35:1" Click="Menu_Aspect235"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S_MenuSize}">
                            <MenuItem Header="{DynamicResource S_Size05}" InputGestureText="1" Click="Menu_Size05"/>
                            <MenuItem Header="{DynamicResource S_Size10}" InputGestureText="2" Click="Menu_Size10"/>
                            <MenuItem Header="{DynamicResource S_Size15}" InputGestureText="3" Click="Menu_Size15"/>
                            <MenuItem Header="{DynamicResource S_Size20}" InputGestureText="4" Click="Menu_Size20"/>
                            <Separator/>
                            <MenuItem x:Name="MiFullscreen" Header="{DynamicResource S_Fullscreen}" InputGestureText="Alt+Enter" Click="Menu_Fullscreen"/>
                            <MenuItem Header="{DynamicResource S_Maximize}" InputGestureText="Ctrl+Enter" Click="Menu_Maximize"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S_Settings}" InputGestureText="F5" Click="Menu_Settings"/>
                        <MenuItem x:Name="MiPlaylist" Header="{DynamicResource S_Playlist}" InputGestureText="F6" Click="Menu_TogglePlaylist"/>
                        <MenuItem Header="{DynamicResource S_Controller}" InputGestureText="F7" Click="Menu_Controller"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S_MediaInfo}" InputGestureText="Ctrl+F1" Click="Menu_MediaInfo"/>
                        <MenuItem Header="{DynamicResource S_About}" InputGestureText="F1" Click="Menu_About"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S_Exit}" InputGestureText="Alt+F4" Click="Caption_Close"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- 영상 표면(3분할 더블클릭 감지) -->
                <Border x:Name="VideoSurface" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"/>

                <!-- 대기 화면: 재생 중이 아닐 때 검은 배경 + 회사 로고
                     (IsHitTestVisible=False로 클릭은 아래 VideoSurface가 그대로 받습니다) -->
                <Border x:Name="IdleLogo" Grid.Row="0" Background="Black" IsHitTestVisible="False">
                    <Image Source="/Assets/Logo.png" Width="190"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- OSD 토스트 -->
                <Border x:Name="Toast" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,24,0,0" Background="{StaticResource OverlayBarBrush}" CornerRadius="8"
                        Padding="16,8" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                </Border>

                <!-- ===== 재생목록 패널 ===== -->
                <Grid x:Name="PlaylistPanel" Grid.Row="0" HorizontalAlignment="Right" Width="280"
                      Background="{StaticResource OverlayBarBrush}" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,2"
                                Content="✕" Click="Menu_TogglePlaylist" ToolTip="{DynamicResource S_TipClosePlaylist}"/>
                        <Button x:Name="ViewModeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Padding="6,2" Content="▤" Click="ViewModeButton_Click" ToolTip="{DynamicResource S_TipViewMode}"/>
                        <TextBlock Text="{DynamicResource S_Playlist}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="PlaylistList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="PlaylistList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="PlaylistList_PreviewMouseRightButtonDown"
                             RequestBringIntoView="PlaylistList_RequestBringIntoView">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="PlaylistMenu" Opened="PlaylistMenu_Opened">
                                <MenuItem Header="{DynamicResource S_PlAddFiles}" Click="PlaylistMenu_AddFiles"/>
                                <MenuItem Header="{DynamicResource S_PlAddFolder}" Click="PlaylistMenu_AddFolder"/>
                                <Separator/>
                                <MenuItem x:Name="MiPlRemove" Header="{DynamicResource S_PlRemove}" Click="PlaylistMenu_Remove"/>
                                <MenuItem x:Name="MiPlDelete" Header="{DynamicResource S_PlDelete}" Click="PlaylistMenu_Delete"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource S_PlViewMode}">
                                    <MenuItem x:Name="MiPlViewTitles" Header="{DynamicResource S_PlViewTitles}" Click="PlaylistMenu_ViewTitles"/>
                                    <MenuItem x:Name="MiPlViewThumbs" Header="{DynamicResource S_PlViewThumbs}" Click="PlaylistMenu_ViewThumbs"/>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 좌측 가장자리 폭 조절 손잡이 -->
                    <Thumb x:Name="PlaylistResizeThumb" Grid.RowSpan="2" Width="6" HorizontalAlignment="Left"
                           Cursor="SizeWE" DragDelta="PlaylistResizeThumb_DragDelta"
                           DragCompleted="PlaylistResizeThumb_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>

                <!-- ===== 전체화면 상단 오버레이 (창 제어) =====
                     마우스를 화면 상단에 대면 표시됩니다. 재생목록/컨트롤바와는 동시에 표시되지 않습니다. -->
                <Border x:Name="TopOverlay" Grid.Row="0" VerticalAlignment="Top" Height="44"
                        Background="{StaticResource OverlayBarBrush}" Visibility="Collapsed">
                    <DockPanel VerticalAlignment="Center" Margin="14,0,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButton}" Content="❐" ToolTip="{DynamicResource S_TipWindowed}"
                                    Click="Menu_Fullscreen"/>
                            <Button Style="{StaticResource CaptionButton}" Content="─" ToolTip="{DynamicResource S_TipMinimize}"
                                    Click="Caption_Minimize"/>
                            <Button Style="{StaticResource CaptionButton}" Content="✕" ToolTip="{DynamicResource S_Close}"
                                    Click="Caption_Close"/>
                        </StackPanel>
                        <TextBlock x:Name="TopOverlayTitle" Text="OctoPlayer" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ===== 하단 컨트롤바 ===== -->
                <Border x:Name="ControlBar" Grid.Row="1" Background="{StaticResource OverlayBarBrush}" Padding="12,6,12,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="CurrentTimeText" Text="00:00:00" DockPanel.Dock="Left"
                                       VerticalAlignment="Bottom" Margin="0,0,10,2" FontSize="12"/>
                            <TextBlock x:Name="TotalTimeText" Text="00:00:00" DockPanel.Dock="Right"
                                       VerticalAlignment="Bottom" Margin="10,0,0,2" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 챕터(체크포인트) 마커: 코드에서 챕터 위치마다 ▼ 화살표를 그립니다. -->
                                <Canvas x:Name="ChapterMarkerCanvas" Grid.Row="0" Height="10"
                                        ClipToBounds="False" Background="Transparent"
                                        SizeChanged="ChapterMarkerCanvas_SizeChanged"/>
                                <Slider x:Name="SeekSlider" Grid.Row="1" Style="{StaticResource MediaSlider}" Maximum="1000"
                                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                                        PreviewMouseUp="SeekSlider_PreviewMouseUp"
                                        ValueChanged="SeekSlider_ValueChanged"/>
                            </Grid>
                        </DockPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource IconButton}" Content="{DynamicResource S_Open}" Click="Menu_OpenFile"
                                        VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TransportButton}" Click="Menu_PrevFile" ToolTip="{DynamicResource S_TipPrev}">
                                    <Path Data="{StaticResource IconPrev}" Fill="{StaticResource TextBrush}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                                        Click="Menu_PlayPause" ToolTip="{DynamicResource S_TipPlayPause}">
                                    <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}" Fill="White"
                                          Width="15" Height="15" Stretch="Uniform" Margin="3,0,0,0"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Click="Stop_Click" ToolTip="{DynamicResource S_TipStop}">
                                    <Path Data="{StaticResource IconStop}" Fill="{StaticResource TextBrush}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Click="Menu_NextFile" ToolTip="{DynamicResource S_TipNext}">
                                    <Path Data="{StaticResource IconNext}" Fill="{StaticResource TextBrush}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,6"/>
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="{DynamicResource S_BtnShuffle}" Click="Menu_ToggleShuffle"/>
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="{DynamicResource S_RepeatNone}" Click="Menu_CycleRepeat"/>
                                <Button x:Name="RepeatCountButton" Style="{StaticResource IconButton}" Content="×1"
                                        ToolTip="{DynamicResource S_TipRepeatCount}" Click="RepeatCount_Click"/>
                                <TextBlock x:Name="RateText" Text="1x" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock x:Name="VolumeText" Text="100" VerticalAlignment="Center" Margin="0,0,6,0"
                                           FontSize="12" Cursor="Hand" MouseLeftButtonDown="VolumeText_Click"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource MediaSlider}" Width="110"
                                        Maximum="100" Value="100" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        PreviewMouseUp="VolumeSlider_PreviewMouseUp"/>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,6"/>
                                <Button x:Name="SubtitleButton" Style="{StaticResource IconButton}" Content="{DynamicResource S_BtnSubtitles}"
                                        ToolTip="{DynamicResource S_TipSubtitles}" Click="SubtitleButton_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="{DynamicResource S_BtnRotate}" Click="Menu_Rotate"/>
                                <Button Style="{StaticResource IconButton}" Content="{DynamicResource S_BtnFullscreen}" Click="Menu_Fullscreen"/>
                                <Button x:Name="PlaylistToggleButton" Style="{StaticResource IconButton}" Content="{DynamicResource S_Playlist}" Click="Menu_TogglePlaylist"/>
                            </StackPanel>
                            <Border/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
        </Grid>
    </Grid>
</Window>
